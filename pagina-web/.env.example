PORT=3000
HOST=127.0.0.1
BEIM_STORAGE_MODE=local
CORS_ORIGIN=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Opcion PostgreSQL local
# Cambia BEIM_STORAGE_MODE a postgres cuando quieras activar la conexion real
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/beim_local

# Alternativa por variables separadas
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=beim_local
PGUSER=postgres
PGPASSWORD=postgres
PGSSLMODE=disable
